# Frozen VT103 evidence must retain its exact bytes and hashes across checkouts.
# Tool-generated whitespace is part of the archived output; source files outside
# these evidence/artifact directories retain the normal whitespace checks.
/Evidence/VT103/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
/docs/BT3_23001853_VT103/** -text whitespace=cr-at-eol
# Markdown's two trailing spaces encode hard line breaks in the authored report.
/docs/BT3_23001853_VT103/*.md whitespace=-blank-at-eol,cr-at-eol
# Preserve Unity's existing empty serialized metadata fields verbatim.
/HUS_Escape/Assets/Editor.meta whitespace=-blank-at-eol,cr-at-eol
